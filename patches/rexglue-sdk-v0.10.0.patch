+#include <errno.h>
+#include <fcntl.h>
 #include <sys/ioctl.h>
 #include <unistd.h>
 
+#include <cstring>
+
 namespace rex::net {
 
+namespace {
+
+// Winsock ioctlsocket commands used by guests (same values on the Xbox 360).
+constexpr uint32_t kWinsockFionbio = 0x8004667E;
+constexpr uint32_t kWinsockFionread = 0x4004667F;
+
+}  // namespace
+
 int socket_close(SocketHandle handle) {
   return close(static_cast<int>(handle));
 }
 
+// Translates the Winsock commands to POSIX: the command values differ, so passing
+// them to ioctl unchanged fails and, for FIONBIO, leaves the socket blocking.
+// The argument is a 32-bit value used like ioctlsocket's u_long on Windows.
 int socket_ioctl(SocketHandle handle, uint32_t cmd, uint8_t* arg) {
-  return ioctl(static_cast<int>(handle), cmd, arg);
+  int fd = static_cast<int>(handle);
+  switch (cmd) {
+    case kWinsockFionbio: {
+      uint32_t enable;
+      std::memcpy(&enable, arg, sizeof(enable));
+      int flags = fcntl(fd, F_GETFL, 0);
+      if (flags < 0) {
+        return -1;
+      }
+      flags = enable ? (flags | O_NONBLOCK) : (flags & ~O_NONBLOCK);
+      return fcntl(fd, F_SETFL, flags) < 0 ? -1 : 0;
+    }
+    case kWinsockFionread: {
+      int available = 0;
+      if (ioctl(fd, FIONREAD, &available) < 0) {
+        return -1;
+      }
+      uint32_t value = uint32_t(available);
+      std::memcpy(arg, &value, sizeof(value));
+      return 0;
+    }
+    default:
+      return ioctl(fd, cmd, arg);
+  }
+}
+
+uint32_t socket_last_error() {
+  switch (errno) {
+    case EAGAIN:
+#if EWOULDBLOCK != EAGAIN
+    case EWOULDBLOCK:
+#endif
+      return 10035;  // WSAEWOULDBLOCK
+    case EINPROGRESS:
+      return 10036;  // WSAEINPROGRESS
+    case EALREADY:
+      return 10037;  // WSAEALREADY
+    case EBADF:
+    case ENOTSOCK:
+      return 10038;  // WSAENOTSOCK
+    case EMSGSIZE:
+      return 10040;  // WSAEMSGSIZE
+    case EADDRINUSE:
+      return 10048;  // WSAEADDRINUSE
+    case EADDRNOTAVAIL:
+      return 10049;  // WSAEADDRNOTAVAIL
+    case ENETDOWN:
+      return 10050;  // WSAENETDOWN
+    case ENETUNREACH:
+      return 10051;  // WSAENETUNREACH
+    case ECONNABORTED:
+      return 10053;  // WSAECONNABORTED
+    case ECONNRESET:
+      return 10054;  // WSAECONNRESET
+    case ENOTCONN:
+      return 10057;  // WSAENOTCONN
+    case ETIMEDOUT:
+      return 10060;  // WSAETIMEDOUT
+    case ECONNREFUSED:
+      return 10061;  // WSAECONNREFUSED
+    case EHOSTUNREACH:
+      return 10065;  // WSAEHOSTUNREACH
+    case EINTR:
+      return 10004;  // WSAEINTR
+    case EACCES:
+      return 10013;  // WSAEACCES
+    case EFAULT:
+      return 10014;  // WSAEFAULT
+    case EINVAL:
+      return 10022;  // WSAEINVAL
+    default:
+      return 10022;  // WSAEINVAL
+  }
 }
 
 }  // namespace rex::net
